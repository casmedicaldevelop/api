# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB

# JWT — generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# OTP
OTP_TTL_MINUTES=15

# Email (Resend)
RESEND_API_KEY=re_j7jbbVzK_NPb4ndvagqAJeaE9gYrXSeJT

# CORS
CORS_ORIGIN=http://localhost:5173

# Server
PORT=3001
# NODE_ENV=development disables Secure cookie flag (allows HTTP in local dev)
# Any other value (or omitting it) = Secure flag ON = requires HTTPS
NODE_ENV=development
